{
    "name": "dhanendran/idempotent-import",
    "description": "WP-CLI command that imports a deterministic JSON snapshot produced by WP Idempotent Export (darylldoyle/idempotent-export) into a WordPress site, idempotently and non-destructively.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "IdempotentImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdempotentImport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:feature": "pest --testsuite=Feature"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
